{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'sem instalacao no deploy: o repo e estatico'",
  "buildCommand": "echo 'sem build no deploy: app/dist ja vem commitado'",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/admin-app", "destination": "/admin", "permanent": true },
    { "source": "/admin-app/:path*", "destination": "/admin", "permanent": true },
    { "source": "/painel-orcamentos", "destination": "/admin/orcamentos", "permanent": true },
    { "source": "/painel-orcamentos/:path*", "destination": "/admin/orcamentos", "permanent": true },
    { "source": "/orcamento-inteligente", "destination": "/admin/orcamentos", "permanent": true },
    { "source": "/orcamento-inteligente/:path*", "destination": "/admin/orcamentos", "permanent": true },
    { "source": "/painel-briefings", "destination": "/admin/briefings", "permanent": true },
    { "source": "/painel-briefings/:path*", "destination": "/admin/briefings", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/app/dist/index.html" },
    { "source": "/admin/", "destination": "/app/dist/index.html" },
    { "source": "/admin/:path*", "destination": "/app/dist/index.html" }
  ]
}
